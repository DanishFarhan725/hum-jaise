---
// The Hum Jaise logo, traced from src/assets/logo-source.png.
// `mark` is the H–J monogram; `lockup` adds the HUM JAISE wordmark beneath.
// Drawn in currentColor so it follows the theme (aubergine by day, light at night).
import markSvg from '../assets/logo-mark.svg?raw';
import lockupSvg from '../assets/logo-lockup.svg?raw';

interface Props {
  variant?: 'mark' | 'lockup';
  height?: number;
}
const { variant = 'mark', height = 30 } = Astro.props;
const svg = (variant === 'lockup' ? lockupSvg : markSvg).replace(
  '<svg ',
  `<svg class="logo logo-${variant}" height="${height}" aria-hidden="true" focusable="false" `
);
---
<Fragment set:html={svg} />

<style>
  :global(.logo) { display: block; width: auto; flex: none; }
</style>
