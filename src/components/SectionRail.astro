---
// A quiet column of lattice stars on wide screens showing where you are in
// the home page. It also lights up the matching link in the header.
interface Props { sections: { id: string; label: string }[] }
const { sections } = Astro.props;
---
<nav class="rail" aria-label="Sections on this page">
  <ol>
    {sections.map((s) => (
      <li>
        <a href={`#${s.id}`} data-rail-link={s.id}>
          <span class="rail-star" aria-hidden="true"></span>
          <span class="rail-label">{s.label}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'));
  const headerLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
  const targets = links
    .map((l) => document.getElementById(l.dataset.railLink || ''))
    .filter((el): el is HTMLElement => !!el);

  const setActive = (id: string) => {
    links.forEach((l) => {
      const on = l.dataset.railLink === id;
      l.classList.toggle('is-active', on);
      if (on) l.setAttribute('aria-current', 'location');
      else l.removeAttribute('aria-current');
    });
    headerLinks.forEach((l) => l.classList.toggle('is-active', l.dataset.sectionLink === id));
  };

  // The current section is the last one whose top has passed 40% of the viewport
  const update = () => {
    const line = window.innerHeight * 0.4;
    let current = targets[0]?.id ?? '';
    for (const t of targets) {
      if (t.getBoundingClientRect().top <= line) current = t.id;
    }
    setActive(current);
  };
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>

<style>
  .rail {
    position: fixed;
    left: clamp(0.75rem, 1.5vw, 1.75rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 25;
    display: none;
  }
  @media (min-width: 90rem) {
    .rail { display: block; }
  }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 32px;
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.85rem;
    font-weight: 650;
  }
  .rail-star {
    width: 0.85rem;
    height: 0.85rem;
    background: var(--plaster-edge);
    -webkit-mask: var(--star) center / contain no-repeat;
    mask: var(--star) center / contain no-repeat;
    transition: transform 360ms cubic-bezier(0.34, 1.56, 0.64, 1), background-color 200ms ease-out;
  }
  .rail-label {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 180ms ease-out, transform 180ms ease-out;
    background: var(--plaster);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  a:hover .rail-label, a:focus-visible .rail-label, a.is-active .rail-label { opacity: 1; transform: none; }
  a:hover .rail-star { background: var(--rose); }
  a.is-active { color: var(--ink); }
  a.is-active .rail-star { background: var(--rose); transform: scale(1.35) rotate(45deg); }
</style>
