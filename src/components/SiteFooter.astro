---
import Mark from './Mark.astro';
---
<footer class="site-footer">
  <div class="threshold" aria-hidden="true"></div>
  <div class="wrap footer-grid">
    <div class="footer-about">
      <a class="footer-brand" href="/" aria-label="Hum Jaise, home">
        <Mark size={30} />
        <span>Hum Jaise</span>
      </a>
      <p class="note">A peer space for neurodivergent people in Pakistan, and anyone who sees themselves here.</p>
      <p class="note" data-hour-note>The light on these pages follows the time of day where you are.</p>
    </div>

    <div class="footer-care">
      <h2 class="footer-h">This isn't a crisis service</h2>
      <p class="note">
        We're peers, not doctors or counsellors. If you're in danger right now, call <a href="tel:1122">1122</a> for
        emergency rescue or <a href="tel:15">15</a> for the police. There are more places to turn on <a href="/resources/#right-now">our resources page</a>.
      </p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <ul>
        <li><a href="/experiences/">Experiences</a></li>
        <li><a href="/principles/">Principles</a></li>
        <li><a href="/resources/">Resources</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/take-part/">Take part</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--plaster-deep);
    margin-top: var(--space-5);
  }
  .site-footer .threshold { transform: translateY(-50%); }
  .footer-grid {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-5);
  }
  @media (min-width: 56rem) {
    .footer-grid { grid-template-columns: 1.1fr 1.3fr 0.8fr; }
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
  }
  .footer-about .note + .note { margin-top: 0.75em; }
  .footer-h { font-size: var(--step-1); margin-bottom: 0.5rem; }
  .footer-nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .footer-nav a { display: inline-flex; min-height: 40px; align-items: center; font-weight: 600; }
</style>
